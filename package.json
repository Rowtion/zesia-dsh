{
  "name": "@zesia/dsh-plugin",
  "version": "0.7.0",
  "private": true,
  "description": "Zesia consultation button and tool for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "configure": "node scripts/configure.mjs",
    "prepack": "npm run build",
    "test:harness:ui": "node scripts/check-harness-ui.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "zod": "^4.6.7",
    "@zesia/runtime": "https://github.com/Rowtion/zesia-skill/releases/download/v0.4.1/zesia-runtime-0.4.1.tgz"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rowtion/zesia-dsh.git"
  }
}
